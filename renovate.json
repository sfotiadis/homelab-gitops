{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "fileMatch": ["(^|/).*\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["(^|/).*\\.ya?ml$"]
  },
  "kubernetes": {
    "fileMatch": ["(^|/).*\\.ya?ml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image overrides in Flux Kustomizations (spec.images)",
      "fileMatch": ["(^|/).*\\.ya?ml$"],
      "matchStrings": [
        "-\\s+name:\\s+(?<depName>[^\\s\"']+)\\s+newTag:\\s+[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "RabbitMQ cluster operator: manifests (git tag) and image override must move together",
      "matchPackageNames": ["/rabbitmq/cluster-operator/"],
      "groupName": "rabbitmq cluster-operator"
    },
    {
      "description": "Cilium (CNI) must be upgraded one minor version at a time",
      "matchDepNames": ["cilium"],
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    }
  ]
}
